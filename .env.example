# Copy to .env at the project root. Expo inlines EXPO_PUBLIC_* at build time.
# Never commit the filled-in file.

EXPO_PUBLIC_THAILLM_API_KEY=
EXPO_PUBLIC_GEMINI_API_KEY=

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Python TTS/speech servers (api/tts_server.py, screens/av.py)
GEMINI_API_KEY=
